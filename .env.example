# Copia questo file in .env per lavorare in locale (.env non va mai nel repository).
# In produzione gli stessi valori si impostano su GitHub: Settings > Secrets and variables > Actions > Variables.
# Sono tutti valori pubblici, ma restano fuori dal codice sorgente.

# Indirizzo pubblico del sito, senza barra finale (serve per l'anteprima WhatsApp).
VITE_SITE_URL=https://NOMEUTENTE.github.io/carmela-60

# URL del Cloudflare Worker che riceve le conferme.
VITE_RSVP_API_URL=https://carmela-60-rsvp.SOTTODOMINIO.workers.dev

# Site Key (pubblica) di Cloudflare Turnstile. In locale va bene la chiave di prova qui sotto;
# GitHub Actions si rifiuta di pubblicarla.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Indicizzazione nei motori di ricerca: "noindex, nofollow" per un evento privato.
VITE_ROBOTS=noindex, nofollow
